# Store Backend API — Environment Variables
# Depends on: Store DB Service

# URL of the Store DB Service (required for data access)
# e.g. https://gitlab-sm-store-db.vercel.app
STORE_DB_URL=

# Timeout for calls to the DB service (ms, default: 5000)
# DEPENDENCY_TIMEOUT_MS=5000

# --- Vercel CI/CD (set in GitLab CI/CD variables) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
